<Window x:Class="NativeCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NativeCalendar"
        Title="Native Calendar" Height="680" Width="1080" MinHeight="560" MinWidth="880"
        Background="#E1D9C9">
  <Window.DataContext>
    <local:CalendarViewModel />
  </Window.DataContext>

  <Window.Icon>
    <BitmapImage UriSource="C:\Users\zack\Documents\Native-Calendar\icon.ico" />
  </Window.Icon>
  
  <Grid Margin="28">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="0,0,28,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Command="{Binding PreviousMonthCommand}" Content="‹" FontSize="20" Width="42" />
          <Button Command="{Binding NextMonthCommand}" Content="›" FontSize="20" Width="42" />
          <Button Command="{Binding TodayCommand}" Content="Hoje" />
        </StackPanel>
        <TextBlock Text="{Binding MonthTitle}" FontSize="28" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="18,0,0,0" />
      </DockPanel>

      <ItemsControl Grid.Row="1" Margin="0,28,0,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Items>
          <TextBlock Text="Dom" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#AE9372" />
          <TextBlock Text="Seg" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#AE9372" />
          <TextBlock Text="Ter" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#AE9372" />
          <TextBlock Text="Qua" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#AE9372" />
          <TextBlock Text="Qui" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#AE9372" />
          <TextBlock Text="Sex" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#AE9372" />
          <TextBlock Text="Sáb" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#AE9372" />
        </ItemsControl.Items>
      </ItemsControl>

      <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" Padding="7" Margin="3">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="#E1D9C9" />
                  <Setter Property="BorderBrush" Value="#212E40" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="Opacity" Value="1" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.4" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#7F4B30" /><Setter Property="Foreground" Value="#fdfdfdff" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <DockPanel>
                <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" />
                <Ellipse Width="9" Height="9" Fill="#424C21" DockPanel.Dock="Right" Visibility="{Binding HasEvents, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Border Grid.Column="1" Background="White" BorderBrush="#7F4B30" BorderThickness="1" CornerRadius="10" Padding="20">
      <StackPanel>
        <TextBlock Text="{Binding SelectedDateTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox Text="{Binding NewEventTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,18,0,6" Padding="10,7" />
        <Button Content="Adicionar evento" Command="{Binding AddEventCommand}" Background="#E1D9C9" Foreground="White" />
        <Separator Margin="0,18" />
        <TextBlock Text="Eventos" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding SelectedDayEvents}" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4">
                <Button DockPanel.Dock="Right" Content="Remover" Command="{Binding DataContext.RemoveEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,16,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
